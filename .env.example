# Скопируйте в .env и заполните. Файл .env в git не попадает.
APP_NAME=bs-test-service
LOG_LEVEL=INFO

# Битрикс24: входящий вебхук вида https://<портал>.bitrix24.ru/rest/1/<токен>/
B24_WEBHOOK_URL=
# application_token исходящего вебхука (проверяется на /webhook/b24)
B24_APP_TOKEN=

# --- Выкладка ---
# HTTPS через Caddy (сертификат получается сам; для IP 1.2.3.4 домен 1-2-3-4.sslip.io)
# COMPOSE_PROFILES=https
# DOMAIN=1-2-3-4.sslip.io
# HTTP_PORT=80
# HTTPS_PORT=443

# Отчёты deploy/autodeploy.sh — только в приватный репозиторий (ключ: .secrets/deploy_key)
# REPORT_REPO=git@github.com:<user>/<private-logs-repo>.git

# Без HTTPS: открыть приложение наружу -> http://<ip>:<APP_PORT>
APP_BIND=127.0.0.1
APP_PORT=18080
